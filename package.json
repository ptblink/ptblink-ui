{
  "name": "@ptblink/ui",
  "version": "0.8.1",
  "description": "PT Blink shared UI primitives, design tokens, and animation helpers.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/utilities.css": "./dist/styles/utilities.css",
    "./brand/icon-128.png": "./dist/brand/icon-128.png",
    "./brand/blinklogo-dark.svg": "./dist/brand/blinklogo-dark.svg"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "release": "npm run build && npm publish --access public"
  },
  "peerDependencies": {
    "@gsap/react": "^2",
    "gsap": "^3",
    "motion": "^12",
    "next": "^15 || ^16",
    "ogl": "^1",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@gsap/react": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "gsap": "^3",
    "motion": "^12",
    "next": "^15",
    "ogl": "^1",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4",
    "tsup": "^8",
    "typescript": "^5"
  },
  "repository": "github:ptblink/ptblink-ui",
  "publishConfig": {
    "access": "public"
  }
}
